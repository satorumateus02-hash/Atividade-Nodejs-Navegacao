<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<div class="container mt-5 mb-5">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-2 fw-semibold">Produtos</span>
                    <h1 class="mb-1">Produtos</h1>
                    <p class="text-muted mb-0">Lista de produtos cadastrados no sistema</p>
                </div>
                <a href="/produtos/cadastro" class="btn btn-primary btn-lg">+ Novo Produto</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th>Preço</th>
                            <th>Estoque</th>
                            <th>Categoria</th>
                            <th>Opções</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% produtos.forEach(produto => { %>
                        <tr>
                            <td><%= produto.id %></td>
                            <td><strong><%= produto.nome %></strong></td>
                            <td><%= produto.descricao %></td>
                            <td>R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></td>
                            <td><%= produto.estoque %> un.</td>
                            <td><%= produto.categoria %></td>
                            <td>
                                <div class="action-buttons">
                                    <a class="btn btn-primary btn-sm" href="/produtos/listar">Listar</a>
                                    <a class="btn btn-success btn-sm" href="/produtos/editar/<%= produto.id %>">Editar</a>
                                    <a class="btn btn-warning btn-sm" href="/produtos/excluir/<%= produto.id %>" onclick="return confirm('Tem certeza que deseja excluir este produto?')">Excluir</a>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>

