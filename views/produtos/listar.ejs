<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">Listar Produtos</h4>
        </div>

        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="text-muted mb-0">Produtos cadastrados no sistema</p>
            <a href="/produtos/cadastro" class="btn btn-success">+ Novo Produto</a>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-dark">
                <tr>
                  <th>ID</th>
                  <th>Nome</th>
                  <th>Descrição</th>
                  <th>Preço</th>
                  <th>Estoque</th>
                  <th>Categoria</th>
                </tr>
              </thead>
              <tbody>
                <% produtos.forEach(produto => { %>
                  <tr>
                    <td><%= produto.id %></td>
                    <td><%= produto.nome %></td>
                    <td><%= produto.descricao %></td>
                    <td>R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></td>
                    <td><%= produto.estoque %> un.</td>
                    <td><%= produto.categoria %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
