<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistema Administrativo</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
      :root {
        --primary: #4f46e5;
        --primary-dark: #3730a3;
        --secondary: #0f172a;
        --soft-bg: #f8fafc;
        --card-bg: rgba(255, 255, 255, 0.9);
        --text: #1f2937;
        --muted: #6b7280;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
      }

      * {
        font-family: "Inter", sans-serif;
      }

      html, body {
        min-height: 100%;
        height: 100%;
      }

      body {
        background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 35%, #ecfeff 100%);
        color: var(--text);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      body > .container {
        flex: 1 0 auto;
      }

      .navbar {
        background: linear-gradient(90deg, var(--secondary) 0%, var(--primary-dark) 100%) !important;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.18);
        padding: 0.9rem 0;
      }

      .navbar-brand {
        font-weight: 800;
        letter-spacing: 0.04em;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #ffffff 0%, #dfe7ff 100%);
        box-shadow: 0 10px 24px rgba(79, 70, 229, 0.22);
        border: 1px solid rgba(255, 255, 255, 0.35);
        position: relative;
      }

      .brand-mark::before {
        content: "";
        position: absolute;
        inset: 6px;
        border-radius: 10px;
        border: 2px solid rgba(79, 70, 229, 0.2);
      }

      .brand-mark-inner {
        position: relative;
        z-index: 1;
        color: var(--primary-dark);
        font-size: 1.25rem;
        font-weight: 900;
        letter-spacing: -0.08em;
      }

      .brand-text {
        font-weight: 800;
        letter-spacing: 0.04em;
      }

      .nav-link {
        font-weight: 600;
        color: rgba(255, 255, 255, 0.85) !important;
        transition: 0.2s ease;
      }

      .nav-link:hover,
      .nav-link.active {
        color: #fff !important;
        opacity: 1;
      }

      .card {
        border: none;
        border-radius: 18px;
        background: var(--card-bg);
        box-shadow: var(--shadow);
        backdrop-filter: blur(6px);
      }

      .card-header {
        border-bottom: 0;
        border-radius: 18px 18px 0 0 !important;
        padding: 1.1rem 1.4rem;
      }

      .btn {
        border-radius: 12px;
        font-weight: 600;
        padding: 0.7rem 1.2rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--primary), #6366f1);
        border: none;
        box-shadow: 0 10px 24px rgba(79, 70, 229, 0.28);
      }

      .btn-success {
        background: linear-gradient(135deg, var(--success), #34d399);
        border: none;
      }

      .btn-warning {
        background: linear-gradient(135deg, #fbbf24, var(--warning));
        border: none;
        color: #111827;
      }

      .btn-secondary {
        background: #e5e7eb;
        border: 0;
        color: var(--secondary);
      }

      .form-control,
      .form-select,
      textarea {
        border: 1.5px solid #dfe7f5;
        border-radius: 12px;
        padding: 0.8rem 0.9rem;
        background: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .form-control:focus,
      .form-select:focus,
      textarea:focus {
        border-color: rgba(79, 70, 229, 0.8);
        box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.15);
      }

      .form-panel {
        border: 1px solid rgba(148, 163, 184, 0.22);
        overflow: hidden;
      }

      .form-header {
        background: linear-gradient(135deg, var(--primary), #6366f1) !important;
        color: #fff;
        border: none;
        padding: 1.2rem 1.4rem;
      }

      .eyebrow {
        display: inline-block;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.8;
        margin-bottom: 0.35rem;
      }

      .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      .field-group {
        margin-bottom: 1.2rem;
      }

      .field-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--secondary);
        font-weight: 600;
      }

      .custom-input {
        background: #f8fafc;
      }

      .form-actions {
        margin-top: 1.5rem;
      }

      .table {
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
      }

      .table thead th {
        background: var(--secondary);
        color: white;
        border: none;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .table tbody td {
        padding: 1rem 0.9rem;
        vertical-align: middle;
      }

      .table-hover tbody tr:hover {
        background-color: rgba(79, 70, 229, 0.04);
      }

      .hero-panel {
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.12), rgba(14, 165, 233, 0.12));
        border: 1px solid rgba(99, 102, 241, 0.18);
        border-radius: 24px;
        box-shadow: var(--shadow);
      }

      .stat-card {
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(148, 163, 184, 0.2);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
      }

      .module-stack {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .module-link {
        display: block;
        text-decoration: none;
        color: var(--text);
      }

      .module-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.2rem 1.3rem;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(148, 163, 184, 0.2);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        width: 100%;
      }

      .module-link:hover .module-card {
        transform: translateY(-2px);
        box-shadow: 0 18px 30px rgba(79, 70, 229, 0.12);
      }

      .module-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
        color: white;
        flex-shrink: 0;
      }

      .module-categorias {
        background: linear-gradient(135deg, #4f46e5, #818cf8);
      }

      .module-clientes {
        background: linear-gradient(135deg, #14b8a6, #2dd4bf);
      }

      .module-fornecedores {
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
      }

      .module-produtos {
        background: linear-gradient(135deg, #ef4444, #f87171);
      }

      .module-copy {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
      }

      .module-copy h3 {
        margin: 0 0 0.2rem;
        font-size: 1.2rem;
        font-weight: 700;
        line-height: 1.3;
      }

      .module-copy p {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .module-arrow {
        margin-left: auto;
        font-size: 1.8rem;
        color: var(--primary);
        font-weight: 700;
        line-height: 1;
        display: flex;
        align-items: center;
      }

      .action-buttons {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        gap: 0.5rem;
      }

      .action-buttons .btn {
        width: auto;
      }

      .text-muted {
        color: var(--muted) !important;
      }

      @media (max-width: 767.98px) {
        .btn {
          width: 100%;
        }

        .d-flex.gap-2 {
          flex-wrap: wrap;
        }

        .module-card {
          align-items: flex-start;
        }

        .module-arrow {
          margin-left: 0;
        }
      }
    </style>
  </head>
  <body>

