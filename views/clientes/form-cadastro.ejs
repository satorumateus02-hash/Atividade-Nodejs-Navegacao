<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
      <div class="card form-panel shadow-sm">
        <div class="card-header form-header">
          <div class="d-flex justify-content-between align-items-center gap-3">
            <div>
              <div class="eyebrow">Cadastro</div>
              <h4 class="mb-0">Novo Cliente</h4>
            </div>
            <span class="status-badge">Ativo</span>
          </div>
        </div>

        <div class="card-body p-4 p-md-5">
          <form action="/clientes" method="POST">
            <div class="field-group">
              <label for="nome">Nome</label>
              <input type="text" class="form-control custom-input" id="nome" name="nome" placeholder="Digite o nome" required />
            </div>

            <div class="field-group">
              <label for="email">Email</label>
              <input type="email" class="form-control custom-input" id="email" name="email" placeholder="Digite o email" required />
            </div>

            <div class="field-group">
              <label for="telefone">Telefone</label>
              <input type="text" class="form-control custom-input" id="telefone" name="telefone" placeholder="Digite o telefone" required />
            </div>

            <div class="field-group">
              <label for="cidade">Cidade</label>
              <input type="text" class="form-control custom-input" id="cidade" name="cidade" placeholder="Digite a cidade" required />
            </div>

            <div class="form-actions d-flex gap-2">
              <button type="submit" class="btn btn-success">Cadastrar</button>
              <a href="/clientes" class="btn btn-secondary">Cancelar</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
