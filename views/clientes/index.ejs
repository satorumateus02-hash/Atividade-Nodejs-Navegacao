<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<div class="container mt-5 mb-5">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-2 fw-semibold">Clientes</span>
                    <h1 class="mb-1">Clientes</h1>
                    <p class="text-muted mb-0">Lista de clientes cadastrados</p>
                </div>

                <a href="/clientes/cadastro" class="btn btn-primary btn-lg">+ Novo Cliente</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Cidade</th>
                            <th>Opções</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% clientes.forEach(mostrar => { %>
                            <tr>
                                <td><%= mostrar.id %></td>
                                <td><strong><%= mostrar.nome %></strong></td>
                                <td><%= mostrar.email %></td>
                                <td><%= mostrar.telefone %></td>
                                <td><%= mostrar.cidade %></td>
                                <td>
                                    <div class="action-buttons">
                                        <a class="btn btn-primary btn-sm" href="/clientes/listar">Listar</a>
                                        <a class="btn btn-success btn-sm" href="/clientes/editar/<%= mostrar.id %>">Editar</a>
                                        <a class="btn btn-warning btn-sm" href="/clientes/excluir/<%= mostrar.id %>" onclick="return confirm('Tem certeza que deseja excluir este cliente?')">Excluir</a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>

