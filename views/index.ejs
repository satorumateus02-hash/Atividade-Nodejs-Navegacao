<%- include("partials/header") %>
<%- include("partials/nav") %>

<div class="container mt-5 mb-5">
  <div class="hero-panel p-4 p-md-5">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-3 fw-semibold">Painel administrativo</span>
        <h1 class="display-5 fw-bold mb-3">Sistema de Cadastro</h1>
        <p class="fs-5 text-muted mb-4">
          Gerencie categorias, clientes, fornecedores e produtos com uma interface mais clara, moderna e fácil de usar.
        </p>

        <div class="d-flex flex-wrap gap-2">
          <a href="/categorias" class="btn btn-primary btn-lg">Categorias</a>
          <a href="/clientes" class="btn btn-primary btn-lg">Clientes</a>
          <a href="/fornecedores" class="btn btn-primary btn-lg">Fornecedores</a>
          <a href="/produtos" class="btn btn-primary btn-lg">Produtos</a>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="row g-3">
          <div class="col-6">
            <div class="stat-card p-3 h-100">
              <div class="text-muted small text-uppercase">Categorias</div>
              <div class="fs-2 fw-bold mt-2">03</div>
            </div>
          </div>
          <div class="col-6">
            <div class="stat-card p-3 h-100">
              <div class="text-muted small text-uppercase">Clientes</div>
              <div class="fs-2 fw-bold mt-2">03</div>
            </div>
          </div>
          <div class="col-6">
            <div class="stat-card p-3 h-100">
              <div class="text-muted small text-uppercase">Fornecedores</div>
              <div class="fs-2 fw-bold mt-2">02</div>
            </div>
          </div>
          <div class="col-6">
            <div class="stat-card p-3 h-100">
              <div class="text-muted small text-uppercase">Produtos</div>
              <div class="fs-2 fw-bold mt-2">02</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="module-stack mt-4">
    <a href="/categorias" class="module-link">
      <div class="module-card">
        <div class="module-icon module-categorias">C</div>
        <div class="module-copy">
          <h3>Categorias</h3>
          <p>Cadastre, edite e acompanhe as categorias do sistema.</p>
        </div>
        <span class="module-arrow">→</span>
      </div>
    </a>

    <a href="/clientes" class="module-link">
      <div class="module-card">
        <div class="module-icon module-clientes">P</div>
        <div class="module-copy">
          <h3>Clientes</h3>
          <p>Controle os clientes ativos e mantenha seus dados organizados.</p>
        </div>
        <span class="module-arrow">→</span>
      </div>
    </a>

    <a href="/fornecedores" class="module-link">
      <div class="module-card">
        <div class="module-icon module-fornecedores">F</div>
        <div class="module-copy">
          <h3>Fornecedores</h3>
          <p>Gerencie os parceiros e fornecedores do negócio com praticidade.</p>
        </div>
        <span class="module-arrow">→</span>
      </div>
    </a>

    <a href="/produtos" class="module-link">
      <div class="module-card">
        <div class="module-icon module-produtos">P</div>
        <div class="module-copy">
          <h3>Produtos</h3>
          <p>Organize o catálogo e acompanhe os itens disponíveis.</p>
        </div>
        <span class="module-arrow">→</span>
      </div>
    </a>
  </div>
</div>

<%- include("partials/footer") %>
