<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<div class="container mt-5 mb-5">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-2 fw-semibold">Fornecedores</span>
                    <h1 class="mb-1">Fornecedores</h1>
                    <p class="text-muted mb-0">Lista de fornecedores parceiros do sistema</p>
                </div>

                <a href="/fornecedores/cadastro" class="btn btn-primary btn-lg">+ Novo Fornecedor</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome da Empresa</th>
                            <th>CNPJ</th>
                            <th>Telefone</th>
                            <th>E-mail</th>
                            <th>Opções</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% fornecedores.forEach(fornecedor => { %>
                        <tr>
                            <td><%= fornecedor.id %></td>
                            <td><strong><%= fornecedor.nome %></strong></td>
                            <td><%= fornecedor.cnpj %></td>
                            <td><%= fornecedor.telefone %></td>
                            <td><%= fornecedor.email %></td>
                            <td>
                                <div class="action-buttons">
                                    <a class="btn btn-primary btn-sm" href="/fornecedores/listar">Listar</a>
                                    <a class="btn btn-success btn-sm" href="/fornecedores/editar/<%= fornecedor.id %>">Editar</a>
                                    <a class="btn btn-warning btn-sm" href="/fornecedores/excluir/<%= fornecedor.id %>" onclick="return confirm('Tem certeza que deseja excluir este fornecedor?')">Excluir</a>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>

