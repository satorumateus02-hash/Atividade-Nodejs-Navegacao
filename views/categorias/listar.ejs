<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">Listar Categorias</h4>
        </div>

        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="text-muted mb-0">Categorias cadastradas no sistema</p>
            <a href="/categorias/cadastro" class="btn btn-success">+ Nova Categoria</a>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-dark">
                <tr>
                  <th>ID</th>
                  <th>Nome</th>
                  <th>Descrição</th>
                  <th>Opções</th>
                </tr>
              </thead>
              <tbody>
                <% categorias.forEach(mostrar => { %>
                  <tr>
                    <td><%= mostrar.id %></td>
                    <td><%= mostrar.nome %></td>
                    <td><%= mostrar.descricao %></td>
                    <td>
                      <span class="text-muted">Visualização</span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
